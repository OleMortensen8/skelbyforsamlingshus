HOST="your_db_host"
DATABASE="your_db_name"
USERNAME="your_db_username"
PASSWORD="your_db_password"

# "development" enables dev-only behavior (HTTP allowed, debug info shown,
# non-Secure cookies, etc.) - leave unset/anything else in production.
ENVIRONMENT="production"
# Public domain, used to build absolute URLs (canonical/OG links, booking
# approve/reject email links). Falls back to skelby-forsamlingshus.dk if unset.
APP_DOMAIN="skelby-forsamlingshus.dk"

# Mail (SMTP) - used by phpmailer.php, phpmailer_2.php, confirmation_mail.php,
# rejected_mail.php and medlem.php to send booking/membership notifications.
MAIL_HOST="smtp.your-provider.example"
MAIL_USERNAME="your_smtp_username"
MAIL_PASSWORD="your_smtp_password"
MAIL_PORT="587"
MAIL_FROM="noreply@your-domain.example"
MAIL_FROM_NAME="Skelby Forsamlinghus"
# Reply-to address shown to recipients; BCC recipients are optional and empty by default.
MAIL_REPLY_TO="kasserer@your-domain.example"
MAIL_BCC_SECRETARY=""
MAIL_BCC_DEV=""
# Recipient for admin booking-notification emails (phpmailer.php).
ADMIN_EMAIL="admin@your-domain.example"

# Cap CAPTCHA (https://trycap.dev) - self-hosted, proof-of-work CAPTCHA
# Public values (safe to share): the widget's endpoint on the visitor's browser.
CAP_SITE_KEY="your_cap_site_key"
CAP_SERVER_URL="http://your-cap-server:3000"
CAP_API_ENDPOINT="http://your-cap-server:3000/your_cap_site_key/"
# Secret: get this from the Cap Standalone dashboard for the site key above.
# Never commit a real value here - this file is only a template.
CAP_SECRET_KEY="your_cap_secret_key"
